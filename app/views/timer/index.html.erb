<div class="container mt-5">

  <div class="card shadow text-center">

    <div class="card-body">

      <h1 class="mb-4">
        🍅 Pomodoro Timer
      </h1>

      <h1
        id="timer"
        class="display-1 fw-bold text-danger">

        25:00

      </h1>

      <div class="mt-4">

        <button
          id="start"
          class="btn btn-success btn-lg">

          ▶ Start

        </button>

        <button
          id="pause"
          class="btn btn-warning btn-lg">

          ⏸ Pause

        </button>

        <button
          id="reset"
          class="btn btn-danger btn-lg">

          🔄 Reset

        </button>

      </div>

      <hr>

      <h4 id="status">

        🍅 Focus Session

      </h4>

    </div>

  </div>

</div>

<script>

let minutes = 25;
let seconds = 0;

let timer = document.getElementById("timer");
let interval;

function display(){

timer.innerHTML =
String(minutes).padStart(2,"0")
+
":"
+
String(seconds).padStart(2,"0");

}

display();

document
.getElementById("start")
.onclick=function(){

clearInterval(interval);

interval=setInterval(function(){

if(seconds==0){

if(minutes==0){

clearInterval(interval);

alert("🎉 Great Job! Pomodoro Completed!");

return;

}

minutes--;

seconds=59;

}

else{

seconds--;

}

display();

},1000);

};

document
.getElementById("pause")
.onclick=function(){

clearInterval(interval);

};

document
.getElementById("reset")
.onclick=function(){

clearInterval(interval);

minutes=25;
seconds=0;

display();

};

</script>