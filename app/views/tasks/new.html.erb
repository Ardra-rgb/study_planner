<div class="container mt-5" style="max-width: 700px;">

  <div class="card shadow">
    <div class="card-body p-4">

      <h2 class="mb-4">📝 Add New Task</h2>

      <%= form_with model: @task, local: true do |form| %>

        <div class="mb-3">
          <%= form.label :title, class: "form-label" %>

          <%= form.text_field :title,
                class: "form-control",
                placeholder: "Enter task title" %>
        </div>

        <div class="mb-3">
          <%= form.label :subject_id, "Subject", class: "form-label" %>

          <%= form.collection_select :subject_id,
                @subjects,
                :id,
                :name,
                { prompt: "Select a Subject" },
                { class: "form-select" } %>
        </div>

        <div class="form-check mb-4">
          <%= form.check_box :completed, class: "form-check-input" %>
          <%= form.label :completed, class: "form-check-label" %>
        </div>

        <div class="d-flex justify-content-between">
          <%= link_to "Cancel", subjects_path, class: "btn btn-secondary" %>

          <%= form.submit "Save Task", class: "btn btn-success" %>
        </div>

      <% end %>

    </div>
  </div>

</div>