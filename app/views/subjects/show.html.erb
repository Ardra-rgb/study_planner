<div class="container mt-5">

  <div class="card shadow">

    <div class="card-body">

      <!-- Subject Header -->

      <h2 class="mb-4">
        📚 <%= @subject.name %>
      </h2>

      <hr>

      <!-- Description -->

      <h5>Description</h5>

      <p>
        <%= @subject.description %>
      </p>

      <hr>

      <!-- Target Hours -->

      <h5>🎯 Target Hours</h5>

      <p>
        <%= @subject.target_hours %> hours/week
      </p>

      <hr>

      <!-- Exam Date -->

      <h5>📅 Exam Date</h5>

      <% if @subject.exam_date.present? %>

        <p>
          <%= @subject.exam_date.strftime("%d %b %Y") %>

          <br>

          <small class="text-muted">
            <%= (@subject.exam_date - Date.today).to_i %> days left
          </small>

        </p>

      <% else %>

        <p class="text-muted">
          No exam date
        </p>

      <% end %>

      <hr>

      <hr>

<h4>📖 Topics</h4>

<% if @subject.topics.any? %>

  <ul class="list-group mb-3">

    <% @subject.topics.each do |topic| %>

      <li class="list-group-item">
        📖 <%= topic.name %>
      </li>

    <% end %>

  </ul>

<% else %>

  <p class="text-muted">
    No topics added yet.
  </p>

<% end %>

<%= link_to "+ Add Topic",
      new_subject_topic_path(@subject),
      class: "btn btn-primary mb-3" %>

      <!-- Tasks -->

      <h4 class="mb-3">
        📝 Tasks
      </h4>

      <% if @tasks.any? %>

        <ul class="list-group">

          <% @tasks.each do |task| %>

            <li class="list-group-item d-flex justify-content-between align-items-center">

              <div class="d-flex align-items-center">

                <%= button_to(
                      task.completed ? "✅ Undo" : "✔ Mark Complete",
                      toggle_task_path(task),
                      method: :patch,
                      class: "btn btn-outline-success btn-sm"
                    ) %>

                <span class="ms-3 fw-semibold">
                  <%= task.title %>
                </span>

              </div>

              <div class="d-flex">

                <%= link_to "Edit",
                      edit_task_path(task),
                      class: "btn btn-warning btn-sm me-2" %>

                <%= button_to "Delete",
                      task_path(task),
                      method: :delete,
                      class: "btn btn-danger btn-sm",
                      form: { style: "display:inline;" } %>

              </div>

            </li>

          <% end %>

        </ul>

      <% else %>

        <p class="text-muted">
          No tasks added yet.
        </p>

      <% end %>

      <div class="mt-3">

        <%= link_to "+ Add Task",
              new_task_path(subject_id: @subject.id),
              class: "btn btn-success" %>

      </div>

      <hr>

      <!-- Progress -->

      <h4 class="mb-3">
        📈 Progress
      </h4>

      <div class="progress" style="height:25px;">

        <div class="progress-bar bg-success"
             style="width:<%= @progress %>%">

          <%= @progress %>%

        </div>

      </div>

      <p class="mt-3 fw-bold">
        <%= @completed_tasks %> / <%= @tasks.count %> tasks completed
      </p>

      <div class="row text-center mt-4">

        <div class="col-md-4">
          <div class="card bg-light">
            <div class="card-body">
              <h5>Total Tasks</h5>
              <h3><%= @tasks.count %></h3>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card bg-light">
            <div class="card-body">
              <h5>Completed</h5>
              <h3><%= @completed_tasks %></h3>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card bg-light">
            <div class="card-body">
              <h5>Pending</h5>
              <h3><%= @tasks.count - @completed_tasks %></h3>
            </div>
          </div>
        </div>

      </div>

      <div class="mt-4">

        <%= link_to "⬅ Back",
              subjects_path,
              class: "btn btn-secondary" %>

      </div>

    </div>

  </div>

</div>