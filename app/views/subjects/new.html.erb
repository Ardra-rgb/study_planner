<div class="container mt-5" style="max-width: 700px;">

  <div class="card shadow">
    <div class="card-body p-4">

      <h2 class="mb-4">📚 Add New Subject</h2>

      <%= form_with model: @subject, local: true do |form| %>

        <div class="mb-3">
          <%= form.label :name, class: "form-label" %>

          <%= form.text_field :name,
                class: "form-control",
                placeholder: "Enter subject name" %>
        </div>

        <div class="mb-3">
          <%= form.label :description, class: "form-label" %>

          <%= form.text_area :description,
                rows: 3,
                class: "form-control",
                placeholder: "Enter description" %>
        </div>

        <div class="mb-3">
          <%= form.label :target_hours, "Target Hours Per Week", class: "form-label" %>

          <%= form.number_field :target_hours,
                class: "form-control",
                placeholder: "10" %>
        </div>

        <div class="mb-3">
          <%= form.label :exam_date, class: "form-label" %>

          <%= form.date_field :exam_date,
                class: "form-control" %>
        </div>

        <div class="d-flex justify-content-between">

          <%= link_to "Cancel", subjects_path, class: "btn btn-secondary" %>

          <%= form.submit "Save Subject", class: "btn btn-success" %>

        </div>

      <% end %>

    </div>
  </div>

</div>