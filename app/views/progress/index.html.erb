<div class="container mt-5">

  <h1 class="mb-4">
    📈 Study Progress
  </h1>

  <% @subjects.each do |subject| %>

    <% total = subject.tasks.count %>
    <% completed = subject.tasks.where(completed: true).count %>

    <% progress =
      total > 0 ? ((completed.to_f / total) * 100).round : 0 %>

    <div class="card shadow mb-4">

      <div class="card-body">

        <h4>
          📚 <%= subject.name %>
        </h4>

        <div class="progress mt-3" style="height:25px;">

          <div
            class="progress-bar bg-success"
            style="width:<%= progress %>%">

            <%= progress %>%

          </div>

        </div>

        <p class="mt-3">

          <strong>

            <%= completed %> /
            <%= total %>

          </strong>

          Tasks Completed

        </p>

      </div>

    </div>

  <% end %>

</div>